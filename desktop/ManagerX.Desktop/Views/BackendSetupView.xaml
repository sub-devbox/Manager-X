<UserControl x:Class="ManagerX.Views.BackendSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="400">
    <Grid Background="{StaticResource BgAppBrush}">
        <Border Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="28,24"
                MaxWidth="390"
                Margin="16"
                VerticalAlignment="Center">
            <StackPanel>
                <!-- Header Icon & Title -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Border Background="#2A1E14" 
                            BorderBrush="{StaticResource AccentAmberBrush}" 
                            BorderThickness="1" 
                            CornerRadius="20" 
                            Padding="10,4" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,10">
                        <TextBlock Text="⚡ BACKEND SERVICE REQUIRED" 
                                   FontSize="10" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource AccentAmberBrush}" />
                    </Border>
                    <TextBlock Text="Manager-X Backend" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextMainBrush}" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Backend is not running. Launch it to continue." 
                               FontSize="12" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Error Message Banner -->
                <Border x:Name="ErrorBorder" 
                        Background="#2A1620" 
                        BorderBrush="{StaticResource AccentRoseBrush}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="10,8" 
                        Margin="0,0,0,14" 
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" 
                               Foreground="{StaticResource AccentRoseBrush}" 
                               FontSize="11.5" 
                               TextWrapping="Wrap" />
                </Border>

                <!-- Status Progress Banner (during launching/polling) -->
                <Border x:Name="StatusBorder" 
                        Background="{StaticResource BgSurfaceSubtleBrush}" 
                        BorderBrush="{StaticResource AccentBlueBrush}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="12,10" 
                        Margin="0,0,0,14" 
                        Visibility="Collapsed">
                    <StackPanel>
                        <ProgressBar x:Name="LaunchProgressBar" 
                                     IsIndeterminate="True" 
                                     Height="4" 
                                     Foreground="{StaticResource AccentBlueBrush}" 
                                     Background="#0F172A" 
                                     BorderThickness="0" 
                                     Margin="0,0,0,8" />
                        <TextBlock x:Name="StatusText" 
                                   Text="Starting backend process..." 
                                   Foreground="{StaticResource TextMainBrush}" 
                                   FontSize="11.5" 
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Python Executable Picker -->
                <TextBlock Text="PYTHON INTERPRETER (VENV)" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextDimBrush}" 
                           Margin="0,0,0,4" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PythonPathInput" 
                             Grid.Column="0" 
                             Margin="0,0,6,0" 
                             ToolTip="Path to python.exe inside your virtual environment" />
                    <Button x:Name="BrowsePythonButton" 
                            Grid.Column="1" 
                            Content="Browse..." 
                            Style="{StaticResource SecondaryButton}" 
                            Padding="10,6" 
                            Click="BrowsePythonButton_Click" />
                </Grid>
                <TextBlock x:Name="PythonHintText" 
                           Text="Auto-detected from project venv" 
                           FontSize="10" 
                           Foreground="{StaticResource AccentEmeraldBrush}" 
                           Margin="0,0,0,12" />

                <!-- Host & Port Row -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>

                    <!-- Host -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="HOST" 
                                   FontSize="10" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextDimBrush}" 
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="HostInput" Text="127.0.0.1" />
                    </StackPanel>

                    <!-- Port -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PORT" 
                                   FontSize="10" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextDimBrush}" 
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="PortInput" Text="8000" />
                    </StackPanel>
                </Grid>

                <!-- Reload Checkbox -->
                <CheckBox x:Name="ReloadCheck" 
                          IsChecked="True" 
                          Foreground="{StaticResource TextMutedBrush}" 
                          FontSize="11.5" 
                          Margin="0,0,0,16">
                    <TextBlock Text="Enable live auto-reload (--reload)" Margin="4,0,0,0" />
                </CheckBox>

                <!-- Launch Button -->
                <Button x:Name="LaunchButton" 
                        Content="🚀  Launch Backend Server" 
                        Style="{StaticResource PrimaryButton}" 
                        Height="40" 
                        Margin="0,0,0,8" 
                        Click="LaunchButton_Click" />

                <!-- Check Again / Manual Retry -->
                <Button x:Name="CheckAgainButton" 
                        Content="🔄  Check Running Server" 
                        Style="{StaticResource SecondaryButton}" 
                        Height="34" 
                        Margin="0,0,0,10" 
                        Click="CheckAgainButton_Click" />

                <!-- Advanced: Custom Remote Server Toggle -->
                <Expander Header="Connect to remote server instead" 
                          Foreground="{StaticResource TextDimBrush}" 
                          FontSize="11" 
                          Margin="0,4,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="CUSTOM API URL" 
                                   FontSize="9.5" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextDimBrush}" 
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="CustomUrlInput" 
                                 Text="http://localhost:8000/api/v1" 
                                 Margin="0,0,0,8" />
                        <Button x:Name="ConnectCustomButton" 
                                Content="Connect to URL" 
                                Style="{StaticResource SecondaryButton}" 
                                Height="30" 
                                Click="ConnectCustomButton_Click" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
