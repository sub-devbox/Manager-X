<UserControl x:Class="ManagerX.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="400">
    <Grid Background="{StaticResource BgAppBrush}">
        <Border Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20,16"
                MaxWidth="340"
                Margin="12"
                VerticalAlignment="Center">
            <StackPanel>
                <!-- Logo & App Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="MANAGER-X" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextMainBrush}" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Desktop Time Tracker" 
                               FontSize="11" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- Error Message Banner -->
                <Border x:Name="ErrorBorder" 
                        Background="#2A1620" 
                        BorderBrush="{StaticResource AccentRoseBrush}" 
                        BorderThickness="1" 
                        CornerRadius="5" 
                        Padding="8,6" 
                        Margin="0,0,0,10" 
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" 
                               Foreground="{StaticResource AccentRoseBrush}" 
                               FontSize="11" 
                               TextWrapping="Wrap" />
                </Border>

                <!-- Server URL -->
                <TextBlock Text="SERVER URL" 
                           FontSize="9" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextDimBrush}" 
                           Margin="0,0,0,2" />
                <TextBox x:Name="ServerUrlInput" 
                         Text="http://localhost:8000/api/v1" 
                         Height="26" 
                         FontSize="11" 
                         Padding="4,2" 
                         Margin="0,0,0,8" />

                <!-- Email Address -->
                <TextBlock Text="EMAIL ADDRESS" 
                           FontSize="9" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextDimBrush}" 
                           Margin="0,0,0,2" />
                <TextBox x:Name="EmailInput" 
                         Height="26" 
                         FontSize="11" 
                         Padding="4,2" 
                         Margin="0,0,0,8" />

                <!-- Password -->
                <TextBlock Text="PASSWORD" 
                           FontSize="9" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextDimBrush}" 
                           Margin="0,0,0,2" />
                <PasswordBox x:Name="PasswordInput" 
                             Height="26" 
                             FontSize="11" 
                             Padding="4,2" 
                             Margin="0,0,0,10" 
                             KeyDown="PasswordInput_KeyDown" />

                <!-- Remember Me Checkbox -->
                <CheckBox x:Name="RememberMeCheck" 
                          IsChecked="True" 
                          Foreground="{StaticResource TextMutedBrush}" 
                          FontSize="11" 
                          Margin="0,0,0,14">
                    <TextBlock Text="Remember me on this machine" Margin="4,0,0,0" />
                </CheckBox>

                <!-- Login Button -->
                <Button x:Name="LoginButton" 
                        Content="Sign In" 
                        Style="{StaticResource PrimaryButton}" 
                        Height="32" 
                        Click="LoginButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
