<UserControl x:Class="ManagerX.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="400">
    <Grid Background="{StaticResource BgAppBrush}">
        <Border Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="32"
                MaxWidth="380"
                Margin="20"
                VerticalAlignment="Center">
            <StackPanel>
                <!-- Logo & App Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="MANAGER-X" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextMainBrush}" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Desktop Time Tracker" 
                               FontSize="12" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Error Message Banner -->
                <Border x:Name="ErrorBorder" 
                        Background="#2A1620" 
                        BorderBrush="{StaticResource AccentRoseBrush}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="10,8" 
                        Margin="0,0,0,16" 
                        Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" 
                               Foreground="{StaticResource AccentRoseBrush}" 
                               FontSize="12" 
                               TextWrapping="Wrap" />
                </Border>

                <!-- Server URL -->
                <TextBlock Text="SERVER URL" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextDimBrush}" 
                           Margin="0,0,0,4" />
                <TextBox x:Name="ServerUrlInput" 
                         Text="http://localhost:8000/api/v1" 
                         Margin="0,0,0,14" />

                <!-- Email Address -->
                <TextBlock Text="EMAIL ADDRESS" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextDimBrush}" 
                           Margin="0,0,0,4" />
                <TextBox x:Name="EmailInput" 
                         Margin="0,0,0,14" />

                <!-- Password -->
                <TextBlock Text="PASSWORD" 
                           FontSize="10" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextDimBrush}" 
                           Margin="0,0,0,4" />
                <PasswordBox x:Name="PasswordInput" 
                             Margin="0,0,0,14" 
                             KeyDown="PasswordInput_KeyDown" />

                <!-- Remember Me Checkbox -->
                <CheckBox x:Name="RememberMeCheck" 
                          IsChecked="True" 
                          Foreground="{StaticResource TextMutedBrush}" 
                          FontSize="12" 
                          Margin="0,0,0,20">
                    <TextBlock Text="Remember me on this machine" Margin="4,0,0,0" />
                </CheckBox>

                <!-- Login Button -->
                <Button x:Name="LoginButton" 
                        Content="Sign In" 
                        Style="{StaticResource PrimaryButton}" 
                        Height="40" 
                        Click="LoginButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
