<UserControl x:Class="ManagerX.Views.TrackerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="460">
    <Grid Background="{StaticResource BgAppBrush}">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Notification banner -->
            <RowDefinition Height="Auto" />
            <!-- Main Content ScrollViewer -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" 
                Background="{StaticResource BgSurfaceBrush}" 
                BorderBrush="{StaticResource BorderSubtleBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentEmeraldBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="MANAGER-X" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="•" Foreground="{StaticResource TextDimBrush}" Margin="8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="UserEmailText" Text="user@example.com" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PinButton" Content="📌 Pin" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,4" Click="PinButton_Click" ToolTip="Toggle Always on Top" />
                    <Button x:Name="RefreshButton" Content="↻" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,4" Click="RefreshButton_Click" ToolTip="Refresh Data" />
                    <Button x:Name="LogoutButton" Content="Sign Out" Style="{StaticResource SecondaryButton}" Padding="8,4" Click="LogoutButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toast / Status Notice Banner -->
        <Border Grid.Row="1" x:Name="NoticeBorder" Background="#163828" BorderBrush="{StaticResource AccentEmeraldBrush}" BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
            <TextBlock x:Name="NoticeText" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- Scrollable Body -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>
                <!-- Timer Display Card -->
                <Border Background="{StaticResource BgSurfaceBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="20" 
                        Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Status Badge -->
                        <Border x:Name="TimerStatusBadge" 
                                Background="#1E293B" 
                                BorderBrush="{StaticResource BorderSubtleBrush}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="10,3" 
                                HorizontalAlignment="Center" 
                                Margin="0,0,0,12">
                            <TextBlock x:Name="TimerStatusText" Text="IDLE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" />
                        </Border>

                        <!-- Stopwatch Digits -->
                        <TextBlock x:Name="TimerDigitsText" 
                                   Text="00:00:00" 
                                   FontFamily="Consolas, Cascadia Code, Courier New" 
                                   FontSize="46" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextMainBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,8" />

                        <!-- Active Project & Task Label -->
                        <TextBlock x:Name="ActiveTaskLabel" 
                                   Text="No task currently running" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextMutedBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,18" 
                                   TextAlignment="Center" 
                                   TextTrimming="CharacterEllipsis" 
                                   MaxWidth="380" />

                        <!-- Timer Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="StartPauseButton" 
                                    Content="▶ Start Timer" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Width="120" 
                                    Height="36" 
                                    Margin="0,0,8,0" 
                                    Click="StartPauseButton_Click" />
                            <Button x:Name="StopSaveButton" 
                                    Content="■ Stop &amp; Log" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Width="110" 
                                    Height="36" 
                                    Margin="0,0,8,0" 
                                    IsEnabled="False" 
                                    Click="StopSaveButton_Click" />
                            <Button x:Name="ResetButton" 
                                    Content="Reset" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Width="70" 
                                    Height="36" 
                                    IsEnabled="False" 
                                    Click="ResetButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Task / Project Selection Card -->
                <Border Background="{StaticResource BgSurfaceBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="16" 
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="LOG TIME TO TASK" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextDimBrush}" 
                                   Margin="0,0,0,12" />

                        <!-- Project Selector -->
                        <TextBlock Text="PROJECT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="ProjectCombo" 
                                  Margin="0,0,0,12" 
                                  Height="34" 
                                  SelectionChanged="ProjectCombo_SelectionChanged" />

                        <!-- Task Selector -->
                        <TextBlock Text="TASK *" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="TaskCombo" 
                                  Margin="0,0,0,12" 
                                  Height="34" />

                        <!-- Work Note / Description -->
                        <TextBlock Text="WORK DESCRIPTION / NOTE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="DescriptionInput" 
                                 Margin="0,0,0,12" 
                                 Height="34" />

                        <!-- Manual Time Entry Section -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ManualHoursInput" 
                                     Grid.Column="0" 
                                     Margin="0,0,8,0" 
                                     Height="34" 
                                     ToolTip="Enter hours (e.g. 1.5 or 0.75)" />
                            <Button x:Name="ManualLogButton" 
                                    Grid.Column="1" 
                                    Content="+ Manual Log" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Height="34" 
                                    Click="ManualLogButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Today's Activity Card -->
                <Border Background="{StaticResource BgSurfaceBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="TODAY'S ACTIVITY" 
                                       FontSize="11" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextDimBrush}" 
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="TodayTotalHoursText" 
                                       Text="Total: 0.0 hrs" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource AccentEmeraldBrush}" 
                                       HorizontalAlignment="Right" 
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl x:Name="RecentEntriesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgSurfaceSubtleBrush}" 
                                            BorderBrush="{StaticResource BorderSubtleBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Padding="10,8" 
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TaskTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProjectName}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding FormattedDuration}" FontFamily="Consolas, Cascadia Code" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoEntriesText" 
                                   Text="No time entries logged yet today." 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextDimBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8" 
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
