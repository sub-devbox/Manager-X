<UserControl x:Class="ManagerX.Views.TrackerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="460">
    <Grid Background="{StaticResource BgAppBrush}">
        <!-- Main Content -->
        <Grid>
            <Grid.RowDefinitions>
                <!-- Notification Banner -->
                <RowDefinition Height="Auto" />
                <!-- Scrollable Body -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Status Notice Banner -->
            <Border Grid.Row="0" x:Name="NoticeBorder" Background="#163828" BorderBrush="{StaticResource AccentEmeraldBrush}" BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="NoticeText" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="12" TextWrapping="Wrap" />
                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource AccentEmeraldBrush}" BorderThickness="0" Cursor="Hand" Click="NoticeClose_Click" />
                </Grid>
            </Border>

            <!-- Scrollable Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,6">
                <StackPanel>
                    <!-- 1. METRICS HEADER CARDS -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Estimated Today -->
                        <Border Grid.Column="0" 
                                Background="{StaticResource BgSurfaceBrush}" 
                                BorderBrush="{StaticResource BorderSubtleBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="EST TIME TODAY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock x:Name="EstTimeTodayText" Text="0.0 hrs" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Tracked Today -->
                        <Border Grid.Column="2" 
                                Background="{StaticResource BgSurfaceBrush}" 
                                BorderBrush="{StaticResource BorderSubtleBrush}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="TRACKED TODAY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock x:Name="TrackedTodayText" Text="0.0 hrs" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 2. TIMER DISPLAY & CONTROLS -->
                    <Border Background="{StaticResource BgSurfaceBrush}" 
                            BorderBrush="{StaticResource BorderSubtleBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="10,8" 
                            Margin="0,0,0,8">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Status Badge -->
                            <Border x:Name="TimerStatusBadge" 
                                    Background="#1E293B" 
                                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="10" 
                                    Padding="8,2" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,0,0,4">
                                <TextBlock x:Name="TimerStatusText" Text="IDLE" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" />
                            </Border>

                            <!-- Stopwatch Digits -->
                            <TextBlock x:Name="TimerDigitsText" 
                                       Text="00:00:00" 
                                       FontFamily="Consolas, Cascadia Code" 
                                       FontSize="34" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextMainBrush}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,2" />

                            <!-- Active Project & Task Label -->
                            <TextBlock x:Name="ActiveTaskLabel" 
                                       Text="Select a project and task to start timer" 
                                       FontSize="10.5" 
                                       Foreground="{StaticResource TextMutedBrush}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,8" 
                                       TextAlignment="Center" 
                                       TextTrimming="CharacterEllipsis" 
                                       MaxWidth="340" />

                            <!-- Timer Action Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="StartPauseButton" 
                                        Content="▶ Start Timer" 
                                        Style="{StaticResource PrimaryButton}" 
                                        Width="100" 
                                        Height="28" 
                                        FontSize="11" 
                                        Margin="0,0,4,0" 
                                        IsEnabled="False" 
                                        Click="StartPauseButton_Click" />
                                <Button x:Name="StopSaveButton" 
                                        Content="■ Stop &amp; Log" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Width="90" 
                                        Height="28" 
                                        FontSize="11" 
                                        Margin="0,0,4,0" 
                                        IsEnabled="False" 
                                        Click="StopSaveButton_Click" />
                                <Button x:Name="ResetButton" 
                                        Content="Reset" 
                                        Style="{StaticResource SecondaryButton}" 
                                        Width="55" 
                                        Height="28" 
                                        FontSize="11" 
                                        IsEnabled="False" 
                                        Click="ResetButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3. PROJECT & TASK SELECTION (SEARCHABLE + CREATE ON NOT FOUND) -->
                    <Border Background="{StaticResource BgSurfaceBrush}" 
                            BorderBrush="{StaticResource BorderSubtleBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="10,8" 
                            Margin="0,0,0,8">
                        <StackPanel>
                            <!-- Project Header -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="PROJECT *" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" />
                                <Button Content="+ New Project" 
                                        HorizontalAlignment="Right" 
                                        Background="Transparent" 
                                        Foreground="{StaticResource AccentBlueBrush}" 
                                        BorderThickness="0" 
                                        FontSize="10" 
                                        Cursor="Hand" 
                                        Click="NewProjectButton_Click" />
                            </Grid>

                            <!-- Project Searchable Combo -->
                            <ComboBox x:Name="ProjectCombo" 
                                      IsEditable="True" 
                                      Height="26" 
                                      FontSize="11" 
                                      Margin="0,0,0,6" 
                                      SelectionChanged="ProjectCombo_SelectionChanged" 
                                      KeyUp="ProjectCombo_KeyUp" />

                            <!-- Task Header -->
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="TASK *" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" />
                                <Button x:Name="NewTaskHeaderButton" 
                                        Content="+ New Task" 
                                        HorizontalAlignment="Right" 
                                        Background="Transparent" 
                                        Foreground="{StaticResource AccentBlueBrush}" 
                                        BorderThickness="0" 
                                        FontSize="10" 
                                        Cursor="Hand" 
                                        IsEnabled="False" 
                                        Click="NewTaskButton_Click" />
                            </Grid>

                            <!-- Task Searchable Combo -->
                            <ComboBox x:Name="TaskCombo" 
                                      IsEditable="True" 
                                      Height="26" 
                                      FontSize="11" 
                                      Margin="0,0,0,6" 
                                      IsEnabled="False" 
                                      SelectionChanged="TaskCombo_SelectionChanged" 
                                      KeyUp="TaskCombo_KeyUp" />

                            <!-- Work Description / Memo -->
                            <TextBlock Text="DESCRIPTION (OPTIONAL)" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,2" />
                            <TextBox x:Name="DescriptionInput" Height="26" FontSize="11" Margin="0,0,0,4" />
                        </StackPanel>
                    </Border>

                    <!-- 4. TODAY'S SCHEDULE -->
                    <Border Background="{StaticResource BgSurfaceBrush}" 
                            BorderBrush="{StaticResource BorderSubtleBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="10,8" 
                            Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="TODAY'S SCHEDULE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ScheduleCountText" Text="0 tasks due" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl x:Name="TodayScheduleList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgSurfaceSubtleBrush}" 
                                                BorderBrush="{StaticResource BorderSubtleBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="5" 
                                                Padding="6,4" 
                                                Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ProjectName}" FontSize="9.5" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding EstimatedHours, StringFormat={}{0}h}" 
                                                           FontFamily="Consolas" 
                                                           FontSize="10" 
                                                           Foreground="{StaticResource AccentAmberBrush}" 
                                                           VerticalAlignment="Center" 
                                                           Margin="6,0" />

                                                <Button Grid.Column="2" 
                                                        Content="▶ Start" 
                                                        Style="{StaticResource SecondaryButton}" 
                                                        Padding="6,2" 
                                                        FontSize="10" 
                                                        Tag="{Binding}" 
                                                        Click="StartScheduledTask_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoScheduleText" 
                                       Text="No tasks scheduled for today." 
                                       FontSize="10.5" 
                                       Foreground="{StaticResource TextDimBrush}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,4" 
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- 5. TODAY'S ACTIVITY BUTTON -->
                    <Button x:Name="ViewTodayActivityButton" 
                            Content="📋 View Today's Activity &amp; Logs" 
                            Style="{StaticResource SecondaryButton}" 
                            Height="30" 
                            FontSize="11" 
                            FontWeight="SemiBold" 
                            Margin="0,0,0,4" 
                            Click="ViewTodayActivityButton_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 6. MODAL OVERLAY: TODAY'S ACTIVITY (EDIT & DELETE LOGS) -->
        <Grid x:Name="ActivityModalOverlay" Background="#90000000" Visibility="Collapsed">
            <Border Background="{StaticResource BgSurfaceBrush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Margin="16" 
                    MaxHeight="600" 
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Border Grid.Row="0" Background="{StaticResource BgSurfaceSubtleBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="14,10" CornerRadius="9,9,0,0">
                        <Grid>
                            <TextBlock Text="Today's Time Entries" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" VerticalAlignment="Center" />
                            <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="CloseActivityModal_Click" />
                        </Grid>
                    </Border>

                    <!-- Entries List with Edit & Delete -->
                    <ScrollViewer Grid.Row="1" Padding="14">
                        <StackPanel>
                            <ItemsControl x:Name="ModalEntriesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgSurfaceSubtleBrush}" 
                                                BorderBrush="{StaticResource BorderSubtleBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="10,8" 
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding TaskTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ProjectName}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FormattedDuration}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" HorizontalAlignment="Right" Margin="0,0,0,6" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="✏ Edit" 
                                                                Style="{StaticResource SecondaryButton}" 
                                                                Padding="6,2" 
                                                                FontSize="10.5" 
                                                                Margin="0,0,4,0" 
                                                                Tag="{Binding}" 
                                                                Click="EditEntry_Click" />
                                                        <Button Content="🗑 Delete" 
                                                                Style="{StaticResource SecondaryButton}" 
                                                                Foreground="{StaticResource AccentRoseBrush}" 
                                                                Padding="6,2" 
                                                                FontSize="10.5" 
                                                                Tag="{Binding}" 
                                                                Click="DeleteEntry_Click" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoModalEntriesText" Text="No entries logged today." Foreground="{StaticResource TextDimBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 7. MODAL OVERLAY: EDIT TIME ENTRY -->
        <Grid x:Name="EditEntryOverlay" Background="#90000000" Visibility="Collapsed">
            <Border Background="{StaticResource BgSurfaceBrush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Margin="24" 
                    Padding="16" 
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Edit Time Entry" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="DURATION (MINUTES)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="EditDurationMinutesInput" Height="32" Margin="0,0,0,10" />

                    <TextBlock Text="DESCRIPTION / NOTE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="EditDescriptionInput" Height="32" Margin="0,0,0,14" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelEditEntry_Click" />
                        <Button Content="Save Changes" Style="{StaticResource PrimaryButton}" Click="SaveEditEntry_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 8. MODAL OVERLAY: CREATE NEW PROJECT -->
        <Grid x:Name="NewProjectOverlay" Background="#90000000" Visibility="Collapsed">
            <Border Background="{StaticResource BgSurfaceBrush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Margin="24" 
                    Padding="16" 
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Create New Project" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="PROJECT NAME *" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="NewProjectNameInput" Height="32" Margin="0,0,0,10" />

                    <TextBlock Text="CLIENT *" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                    <ComboBox x:Name="NewProjectClientCombo" Height="32" Margin="0,0,0,14" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelNewProject_Click" />
                        <Button x:Name="SubmitNewProjectButton" Content="Create Project" Style="{StaticResource PrimaryButton}" Click="SubmitNewProject_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 9. MODAL OVERLAY: CREATE NEW TASK -->
        <Grid x:Name="NewTaskOverlay" Background="#90000000" Visibility="Collapsed">
            <Border Background="{StaticResource BgSurfaceBrush}" 
                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Margin="24" 
                    Padding="16" 
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Create New Task" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextMainBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="TASK TITLE *" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="NewTaskTitleInput" Height="32" Margin="0,0,0,10" />

                    <TextBlock Text="ESTIMATED HOURS (OPTIONAL)" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="NewTaskEstHoursInput" Text="1.0" Height="32" Margin="0,0,0,14" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CancelNewTask_Click" />
                        <Button x:Name="SubmitNewTaskButton" Content="Create Task" Style="{StaticResource PrimaryButton}" Click="SubmitNewTask_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
