<Window x:Class="ManagerX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Manager X - Time Tracker" 
        Icon="app.png"
        Height="620" 
        Width="390" 
        MinHeight="64" 
        MinWidth="340"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Border x:Name="RootWindowBorder"
            Background="{StaticResource BgAppBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Grid>
            <!-- 1. FULL APPLICATION MODE -->
            <Grid x:Name="FullModeContainer" Visibility="Visible">
                <Grid.RowDefinitions>
                    <!-- Custom Frameless Titlebar -->
                    <RowDefinition Height="30" />
                    <!-- Clickable Live Status Ribbon -->
                    <RowDefinition Height="26" />
                    <!-- Body Content -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Custom Modern Titlebar -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="7,7,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="10,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- App Icon & Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="app.png" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock x:Name="TitleText"
                                       Text="Manager X - Time Tracker"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMainBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Titlebar Control Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Refresh Button (visible when logged in) -->
                            <Button x:Name="TitleRefreshButton"
                                    Content="🔄"
                                    FontSize="10"
                                    Width="22" Height="20"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="TitleRefreshButton_Click"
                                    ToolTip="Refresh Data"
                                    Visibility="Collapsed" />

                            <!-- Logout Button (Icon only, visible when logged in) -->
                            <Button x:Name="TitleLogoutButton"
                                    Content="🚪"
                                    FontSize="11"
                                    Width="22" Height="20"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="TitleLogoutButton_Click"
                                    ToolTip="Log Out"
                                    Visibility="Collapsed" />

                            <!-- Minimize to Tray -->
                            <Button Content="🗕"
                                    FontSize="10"
                                    Width="22" Height="20"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="TitleMinimize_Click"
                                    ToolTip="Minimize to System Tray" />

                            <!-- Close / Hide -->
                            <Button Content="✕"
                                    FontSize="10"
                                    Width="22" Height="20"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="TitleClose_Click"
                                    ToolTip="Close to Tray" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Clickable Live Status Ribbon -->
                <Border Grid.Row="1" 
                        Background="{StaticResource BgSurfaceSubtleBrush}" 
                        BorderBrush="{StaticResource BorderSubtleBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="8,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Status Pills (Clickable to open in default browser) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Backend API Pill -->
                            <Border x:Name="ApiStatusBadge" 
                                    Background="#1E293B" 
                                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="10" 
                                    Padding="6,1.5" 
                                    Margin="0,0,6,0" 
                                    Cursor="Hand" 
                                    MouseLeftButtonDown="ApiStatusBadge_MouseLeftButtonDown"
                                    ToolTip="Backend API - Click to open Swagger API Docs in browser">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ApiStatusDot" Width="6" Height="6" Fill="{StaticResource AccentRoseBrush}" Margin="0,0,4,0" />
                                    <TextBlock x:Name="ApiStatusText" Text="API: 8000" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Frontend Web Pill -->
                            <Border x:Name="WebStatusBadge" 
                                    Background="#1E293B" 
                                    BorderBrush="{StaticResource BorderSubtleBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="10" 
                                    Padding="6,1.5" 
                                    Margin="0,0,6,0" 
                                    Cursor="Hand" 
                                    MouseLeftButtonDown="WebStatusBadge_MouseLeftButtonDown"
                                    ToolTip="Frontend Web App - Click to open Web Dashboard in browser">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="WebStatusDot" Width="6" Height="6" Fill="{StaticResource AccentRoseBrush}" Margin="0,0,4,0" />
                                    <TextBlock x:Name="WebStatusText" Text="Web: 3000" FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Stop All Services Button -->
                        <Button Grid.Column="1" 
                                x:Name="StopServicesButton" 
                                Content="🛑 Stop All" 
                                FontSize="9.5" 
                                Padding="6,1" 
                                Height="19" 
                                Style="{StaticResource DangerOutlineButton}" 
                                Cursor="Hand" 
                                Click="StopServicesButton_Click" 
                                ToolTip="Safely shut down running Backend and Frontend servers" />
                    </Grid>
                </Border>

                <!-- Main View Content -->
                <ContentControl Grid.Row="2" x:Name="MainContent" />

                <!-- Startup Loading Overlay -->
                <Grid Grid.Row="2" x:Name="LoadingOverlay" Background="{StaticResource BgAppBrush}" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="app.png" Width="36" Height="36" Margin="0,0,0,12" HorizontalAlignment="Center" />
                        <TextBlock Text="MANAGER X" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextMainBrush}" 
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Time Tracker" 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextMutedBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,2,0,14" />
                        <ProgressBar IsIndeterminate="True" 
                                     Width="120" 
                                     Height="3" 
                                     Foreground="{StaticResource AccentBlueBrush}" 
                                     Background="{StaticResource BgSurfaceBrush}" 
                                     BorderThickness="0" />
                        <TextBlock x:Name="LoadingStatusText" 
                                   Text="Connecting..." 
                                   FontSize="10.5" 
                                   Foreground="{StaticResource TextDimBrush}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 2. COMPACT FLOATING MINI-WIDGET MODE (50% Opacity) -->
            <Grid x:Name="MiniWidgetContainer" 
                  Visibility="Collapsed" 
                  MouseLeftButtonDown="MiniWidget_MouseLeftButtonDown"
                  Background="Transparent">
                <Border Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <!-- Drag Grip -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Digits -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Task & Project Info -->
                            <ColumnDefinition Width="*" />
                            <!-- Actions -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Grip Handle -->
                        <TextBlock Grid.Column="0" 
                                   Text="⋮⋮" 
                                   FontSize="14" 
                                   Foreground="{StaticResource TextDimBrush}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0" 
                                   Cursor="SizeAll" />

                        <!-- Stopwatch Digits -->
                        <TextBlock Grid.Column="1" 
                                   x:Name="MiniDigitsText" 
                                   Text="00:00:00" 
                                   FontFamily="Consolas, Cascadia Code" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource AccentEmeraldBrush}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,10,0" />

                        <!-- Task & Project Title (Truncated) -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock x:Name="MiniTaskTitle" 
                                       Text="Active Task" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextMainBrush}" 
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="MiniProjectTitle" 
                                       Text="Project" 
                                       FontSize="9.5" 
                                       Foreground="{StaticResource TextDimBrush}" 
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Controls: Pause, Stop, Reset, Expand -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="MiniPauseButton" 
                                    Content="⏸" 
                                    Width="26" Height="26" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Padding="0" 
                                    Margin="0,0,4,0" 
                                    Click="MiniPauseButton_Click" 
                                    ToolTip="Pause / Resume Timer" />
                            <Button x:Name="MiniStopButton" 
                                    Content="■" 
                                    Width="26" Height="26" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Foreground="{StaticResource AccentRoseBrush}" 
                                    Padding="0" 
                                    Margin="0,0,4,0" 
                                    Click="MiniStopButton_Click" 
                                    ToolTip="Stop &amp; Log Time" />
                            <Button Content="⤢" 
                                    Width="26" Height="26" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Padding="0" 
                                    Click="MiniExpandButton_Click" 
                                    ToolTip="Restore Full Window" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
