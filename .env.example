# Manager X Environment Configuration Example
# Copy this file to .env and adjust variables as needed

SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-or-base64-secret
PROJECT_NAME="Manager X"

# Dynamic Service URLs & Host Ports (Change these if 3000 or 8000 are already in use)
FRONTEND_PORT=3000
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Allowed CORS Origins (comma-separated or JSON list)
# When deploying to a Linux server or LAN, add your server's IP/domain and custom port:
# e.g. CORS_ORIGINS=http://localhost:3000,http://192.168.1.50:3000,http://managerx.local
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# SQLite Data Directory (optional: defaults to ../data locally, /app/data in Docker)
# DATA_DIR=./data
